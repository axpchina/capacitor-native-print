{
  "name": "@robusthomes/capacitor-native-print",
  "version": "0.2.0",
  "description": "Capacitor 8 plugin for native current-page and app-private PDF printing.",
  "main": "dist/plugin.cjs.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "android/proguard-rules.pro",
    "dist/",
    "ios/Sources",
    "Package.swift",
    "CapacitorNativePrint.podspec",
    "README.md",
    "android/vendor/",
    "CHANGELOG.md",
    "RELEASE_NOTES.md",
    "KNOWN_ISSUES.md",
    "LICENSE",
    "SECURITY_REVIEW.md"
  ],
  "author": "Robust Homes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axpchina/capacitor-native-print.git"
  },
  "homepage": "https://github.com/axpchina/capacitor-native-print#readme",
  "bugs": {
    "url": "https://github.com/axpchina/capacitor-native-print/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "print",
    "ios",
    "android"
  ],
  "scripts": {
    "build": "npm run clean && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "verify:web": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0 <9.0.0"
  },
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
